{
  "name": "wp-animted-counter",
  "version": "1.9.1",
  "private": true,
  "description": "Development checks for the WP Animated Counter WordPress plugin",
  "scripts": {
    "test": "node tests/frontend.cjs && node tests/admin.cjs && node tests/audit.cjs",
    "test:browser": "node tests/browser.cjs",
    "audit:duplicates": "jscpd --config .jscpd.json",
    "audit:dead-code": "jscpd assets --dead-code --entry admin.js --entry frontend.js --min-confidence 80",
    "build": "node scripts/build.cjs"
  },
  "devDependencies": {
    "jscpd": "5.4.1",
    "jsdom": "29.1.1",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "postcss": "8.5.31"
  }
}
